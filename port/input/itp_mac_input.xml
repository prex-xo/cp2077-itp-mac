<?xml version="1.0"?>
<!-- Immersive Third Person (Mac port) hotkeys, loaded by Input Loader. Change a key by editing the IK_ name.
     Defaults (all unused by the game): , = quick first person (hold)   ; = shoulder zoom (hold)
     ' = front view (hold)   [ = previous camera profile   ] = next camera profile   . = free look (hold, reserved) -->
